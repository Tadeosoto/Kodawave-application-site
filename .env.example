# Frontend (Vite)
VITE_NEWSLETTER_ENDPOINT=/api/subscribe
VITE_NEWSLETTER_NOTIFY_EMAIL=michelle.castellanos@caenna.com

# Google Analytics 4 (solo producción). Crear en https://analytics.google.com → Admin → Data Streams
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Serverless API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=ssb_secret_REEMPLAZAR

# Optional: launch broadcast endpoint auth and sender
NEWSLETTER_ADMIN_TOKEN=REEMPLAZAR
RESEND_API_KEY=REEMPLAZAR
RESEND_FROM_EMAIL=Launch <hello@yourdomain.com>

# Opcional: correo(s) del equipo que reciben aviso en cada alta a la lista (servidor). Varios: coma o ;
SUBSCRIBE_NOTIFY_EMAIL=notify@yourdomain.com
